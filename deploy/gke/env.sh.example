# Variables for docs/gke-plan.md and deploy/gke/teardown.sh. Copy to deploy/gke/env.sh
# (git-ignored), fill in, and `source deploy/gke/env.sh` before each command block.
# No secrets belong here: every credential comes from gcloud's own login.

export PROJECT_ID="meridian-fleet-agents"
export PROJECT_NUMBER=""          # gcloud projects describe "$PROJECT_ID" --format='value(projectNumber)'
export BILLING_ACCOUNT=""         # gcloud billing projects describe "$PROJECT_ID" --format='value(billingAccountName)' (without "billingAccounts/")
export REGION="us-central1"
export ZONE="us-central1-a"       # one zone: a zonal cluster (one free-tier management fee credit)
export CLUSTER_NAME="meridian-substrate"
export CLUSTER_VERSION="1.37"     # the minimum Substrate supports; check the Regular channel carries it
export RELEASE_CHANNEL="regular"
export SYSTEM_POOL="system"
export WORKER_POOL="substrate"
export SYSTEM_MACHINE_TYPE="c3-standard-4"   # Google: c3-standard-4 or larger; Postgres requests 2 vCPU
export WORKER_MACHINE_TYPE="c3-standard-4"   # Spot in this plan
export WORKER_MAX_NODES="2"
export NODE_GSA_NAME="ate-gke-node"                   # setup-gcp's default name
export SNAPSHOT_TRANSFER_GSA_NAME="ate-snapshot-transfer"  # setup-gcp's default name
export BUCKET_NAME="${PROJECT_ID}-ate-snapshots"      # at most 56 characters; setup-gcp also makes ${BUCKET_NAME}-assets
export AR_REPO="meridian"                             # Artifact Registry, Docker format, in $REGION
export BUDGET_NAME="meridian-gke-30usd"
