{
  "name": "meridian-command-center",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Meridian Command Center: the web client of the Fleet API (development identity only).",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=9.2.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "gen:api": "openapi-typescript ../openapi/meridian-api.json -o src/api/schema.ts",
    "check:api": "openapi-typescript ../openapi/meridian-api.json -o src/api/schema.ts && git diff --exit-code -- src/api/schema.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.107.1",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "jsdom": "29.1.1",
    "msw": "3.0.4",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
